<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>MusicFree</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<!-- 只声明 CFBundleIconName，CFBundleIcons 交给 actool 自动生成 -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!--
	  iOS 的「App 切换器（多任务界面）」和「设置 -> 通用 -> iPhone 储存空间」
	  读取的是顶层 CFBundleIconName，而不是 CFBundleIcons 里的嵌套值。
	  缺失时桌面上有图标、但多任务卡片会是空白占位。
	  同时补 CFBundleIconFile 作为老系统（iOS 13 以下兜底）的兼容键。
	-->
	
	
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- 插件音源大量使用 http:// 与自签名 https，侧载包不受 App Store ATS 审核约束，放开 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- react-native-image-picker 的 launchImageLibrary 必需，缺失会直接 crash -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>用于选择歌单封面、自定义主题背景与本地图片</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>用于把歌词封面等图片保存到相册</string>
	<key>NSCameraUsageDescription</key>
	<string>用于拍摄歌单封面（本版本未启用相机）</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>本应用不使用麦克风</string>

	<!-- react-native-track-player 后台播放 / 锁屏与控制中心 -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
	</array>

	<!--
	  CarPlay 场景不在 Info.plist 声明 UIApplicationSceneManifest。

	  原因（实测）：本工程是 RN 0.76 + Expo 52 的纯 legacy AppDelegate，
	  源码里没有任何 UIWindowSceneDelegate 实现，RN 只在
	  didFinishLaunching 里用 legacy 方式建 window。
	  一旦声明 SceneManifest，系统改走 UIScene 生命周期去建主 App 场景，
	  RN 的 window 就挂不上 -> 手机主 App 黑屏（v11141849 / v11141931 已验证）。

	  改为完全不声明 SceneManifest：
	    - 主 App：走 legacy 路径，和 v17 一样正常显示
	    - CarPlay：连接车机时系统请求 CPTemplateApplicationSceneSessionRoleApplication
	      场景，plist 里没有该配置，UIKit 会回调 AppDelegate 的
	      application:configurationForConnectingSceneSession:options:，
	      由代码返回 CarPlay 配置（Apple 文档明确此 delegate 用于
	      "configuration that isn't in your app's Info.plist"）。
	      entitlement com.apple.developer.carplay-audio 保留，
	      之前 v11141849 已证明车机能出图标。
	-->

	<!-- 允许"文件"App 向 Documents 导入本地音乐与 .js 插件，并支持"打开方式" -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- bootstrap.ts 的 extraMakeup 处理 musicfree://install/<url> 安装插件 -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.musicfree.ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>musicfree</string>
			</array>
		</dict>
	</array>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!--
	  启动图不用 storyboard：上游 LaunchScreen.storyboard 是个老模板，
	  用 Xcode 16.4 / iOS 18.5 SDK 编译出的 nib 在 iOS 16.1.1 上
	  UIStoryboard initWithBundle: 会抛 ObjC 异常 -> SIGABRT -> 启动秒退。
	  改用 iOS 14+ 原生 UILaunchScreen 字典（纯色启动），完全绕开 nib 解析。
	-->
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
